ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5080
ConnectionStrings__Database="Host=127.0.0.1;Database=driving_school;Username=driving_school;Password=REPLACE_ME"
