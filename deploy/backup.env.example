PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=driving_school
PGUSER=driving_school
PGPASSFILE=/etc/driving-school/backup.pgpass
DOCUMENT_DIR=/var/lib/driving-school/documents
BACKUP_WORK=/var/lib/driving-school/backup-work
RESTIC_REPOSITORY=sftp:backup-user@backup-host:/driving-school
RESTIC_PASSWORD_FILE=/etc/driving-school/restic-password
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
